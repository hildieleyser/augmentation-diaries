# Copy to .env and fill in. Nothing here is required to run locally.

PORT=3000
HOST=127.0.0.1

# Where enquiries are appended as JSON Lines.
DATA_DIR=./data

# Needed to read GET /api/enquiries. Leave unset and that endpoint stays shut.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=

# Submissions allowed per IP per window.
RATE_MAX=5
RATE_WINDOW_MS=600000

# Set to 1 only when a reverse proxy sets X-Forwarded-For.
TRUST_PROXY=0
